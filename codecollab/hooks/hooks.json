{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/capture.py\" observe", "timeout": 5 },
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/recall.py\"", "timeout": 60 },
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/handoff.py\" prompt-submit", "timeout": 5 },
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/shared_handoff.py\" notify", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/capture.py\" turn" },
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/shared_handoff.py\" persist-turn-hook", "timeout": 5 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/capture.py\" sweep" },
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/handoff.py\" session-start", "timeout": 5 },
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/instructions.py\" session-start", "timeout": 5 },
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/shared_handoff.py\" refresh", "timeout": 5 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent_recall.py\" start", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/entity_history.py\" post-read", "timeout": 20 }
        ]
      },
      {
        "matcher": "mcp__.*vonic_resolve_event",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/resolve_audit.py\" post-tool-use", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/entity_history.py\" pre-edit", "timeout": 20 }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent_recall.py\" stash", "timeout": 5 }
        ]
      },
      {
        "matcher": "Bash|mcp__plugin_codecollab_codecollab__.*",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/approval_gate.py\"", "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/capture.py\" finalize" },
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/handoff.py\" session-end", "timeout": 5 }
        ]
      }
    ]
  }
}
