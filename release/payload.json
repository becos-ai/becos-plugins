{
  "_comment": "ALLOWLIST. Only paths listed in `include` are published. Anything not listed here never leaves the private repo. Adding a file to a source repo does NOT publish it - it must be added here deliberately.",
  "allowed_root_files": [".gitignore", "README.md", "LICENSE"],
  "allowed_root_dirs": [".claude-plugin", ".agents", ".github", "release", "becos", "becos-codex", "codecollab", "codex-codecollab"],
  "plugins": [
    {
      "id": "becos",
      "runtime": "claude",
      "source_repo": "becos-ai/becos-claude-plugin",
      "source_subdir": "becos",
      "dest": "becos",
      "manifest": ".claude-plugin/plugin.json",
      "include": [".claude-plugin", "commands", "contracts", "hooks", "scripts"],
      "exclude": ["**/__pycache__/**", "**/*.pyc", "scripts/test_*.py"]
    },
    {
      "id": "codecollab",
      "runtime": "claude",
      "source_repo": "becos-ai/becos-claude-plugin",
      "source_subdir": "legacy/codecollab",
      "dest": "codecollab",
      "manifest": ".claude-plugin/plugin.json",
      "include": [".claude-plugin", "hooks", "scripts"],
      "exclude": ["**/__pycache__/**", "**/*.pyc", "scripts/test_*.py"]
    },
    {
      "id": "becos-codex",
      "runtime": "codex",
      "source_repo": "becos-ai/codex-codecollab-plugin",
      "source_subdir": ".",
      "dest": "becos-codex",
      "manifest": ".codex-plugin/plugin.json",
      "include": [".codex-plugin", "bin", "deliver", "hooks", "mcp.json"],
      "exclude": ["**/__pycache__/**", "**/*.pyc", "deliver/VENDORED_FROM.txt"]
    },
    {
      "id": "codex-codecollab",
      "runtime": "codex",
      "source_repo": "becos-ai/codex-codecollab-plugin",
      "source_subdir": "legacy",
      "dest": "codex-codecollab",
      "manifest": ".codex-plugin/plugin.json",
      "include": [".codex-plugin", "hooks"],
      "exclude": ["**/__pycache__/**", "**/*.pyc"]
    }
  ]
}
